{
  "name": "vexon-security-scanner",
  "version": "4.0.0",
  "description": "Defensive website security scanner with OpenRouter-assisted reporting",
  "main": "electron/main.js",
  "author": "Vexon",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test test/*.test.js",
    "build:win": "electron-builder --win nsis --publish never",
    "test:desktop": "electron scripts/desktop-smoke.js"
  },
  "devDependencies": {
    "electron": "44.4.1",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "electron-updater": "^6.8.9",
    "ipaddr.js": "2.2.0"
  },
  "build": {
    "appId": "gr.vexon.securityscanner",
    "productName": "Vexon Security Scanner",
    "asar": true,
    "files": [
      "electron/**/*",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Vexon-Security-Scanner-Setup-${version}-${arch}.${ext}",
      "icon": "renderer/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "gochag421-beep",
        "repo": "site-admin-panel"
      }
    ]
  }
}
